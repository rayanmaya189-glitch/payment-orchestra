# =============================================================================
# Payment Orchestra — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values.
#
# Naming convention:
#   {SERVICE}_{VAR}            — Per-service variable
#   {VAR}                      — Global variable (shared across services)
# =============================================================================

# ─── PostgreSQL (Database Pools) ─────────────────────────────────────────────
# Each service connects to its own database. The connection pool URL format is:
#   postgres://user:password@host:port/{database_name}
#
# If a service's pool URL is not set, it falls back to the global DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_orchestra

# Per-service database URLs (override DATABASE_URL per service).
# Convention: {POOL_NAME}_DATABASE_URL where POOL_NAME is the uppercase
# pool name passed to create_service_pool() (e.g., "SAGA_COORDINATOR"):
OPERATOR_DATABASE_URL=
IAM_DATABASE_URL=
COMPLIANCE_DATABASE_URL=
CONNECTOR_GATEWAY_DATABASE_URL=
ORCHESTRATION_DATABASE_URL=
INVOICE_DATABASE_URL=
PAYMENT_LINK_DATABASE_URL=
SUBSCRIPTION_DATABASE_URL=
RECONCILIATION_DATABASE_URL=
RISK_DATABASE_URL=
AI_ASSISTANT_DATABASE_URL=
AI_GATEWAY_DATABASE_URL=
DOCUMENT_DATABASE_URL=
NOTIFICATION_DATABASE_URL=
ANALYTICS_DATABASE_URL=
SAGA_COORDINATOR_DATABASE_URL=
SCHEDULER_DATABASE_URL=
MERCHANT_ACQUIRER_LINK_DATABASE_URL=
OUTBOX_RELAY_DATABASE_URL=
API_GATEWAY_DATABASE_URL=
MERCHANT_CONNECTOR_ONBOARDING_DATABASE_URL=
DISPUTE_DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── NATS (Message Bus) ──────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# Per-service NATS credentials (used if NATS requires authentication):
OPERATOR_NATS_USERNAME=
OPERATOR_NATS_PASSWORD=
IAM_NATS_USERNAME=
IAM_NATS_PASSWORD=
COMPLIANCE_NATS_USERNAME=
COMPLIANCE_NATS_PASSWORD=
CONNECTOR_GATEWAY_NATS_USERNAME=
CONNECTOR_GATEWAY_NATS_PASSWORD=
ORCHESTRATION_NATS_USERNAME=
ORCHESTRATION_NATS_PASSWORD=
INVOICE_NATS_USERNAME=
INVOICE_NATS_PASSWORD=
PAYMENT_LINK_NATS_USERNAME=
PAYMENT_LINK_NATS_PASSWORD=
SUBSCRIPTION_NATS_USERNAME=
SUBSCRIPTION_NATS_PASSWORD=
RECONCILIATION_NATS_USERNAME=
RECONCILIATION_NATS_PASSWORD=
RISK_NATS_USERNAME=
RISK_NATS_PASSWORD=
AI_ASSISTANT_NATS_USERNAME=
AI_ASSISTANT_NATS_PASSWORD=
AI_GATEWAY_NATS_USERNAME=
AI_GATEWAY_NATS_PASSWORD=
DOCUMENT_NATS_USERNAME=
DOCUMENT_NATS_PASSWORD=
NOTIFICATION_NATS_USERNAME=
NOTIFICATION_NATS_PASSWORD=
ANALYTICS_NATS_USERNAME=
ANALYTICS_NATS_PASSWORD=
SAGA_COORDINATOR_NATS_USERNAME=
SAGA_COORDINATOR_NATS_PASSWORD=
SCHEDULER_NATS_USERNAME=
SCHEDULER_NATS_PASSWORD=
MERCHANT_ACQUIRER_LINK_NATS_USERNAME=
MERCHANT_ACQUIRER_LINK_NATS_PASSWORD=
OUTBOX_RELAY_NATS_USERNAME=
OUTBOX_RELAY_NATS_PASSWORD=
API_GATEWAY_NATS_USERNAME=
API_GATEWAY_NATS_PASSWORD=
MERCHANT_CONNECTOR_ONBOARDING_NATS_USERNAME=
MERCHANT_CONNECTOR_ONBOARDING_NATS_PASSWORD=
DISPUTE_NATS_USERNAME=
DISPUTE_NATS_PASSWORD=

# ─── gRPC Ports ──────────────────────────────────────────────────────────────
# Per-service gRPC and health ports (auto-assigned defaults if not set):
operator_service_grpc_port=9001
operator_service_health_port=9101
iam_service_grpc_port=9002
iam_service_health_port=9102
compliance_service_grpc_port=9003
compliance_service_health_port=9103
connector_gateway_grpc_port=9004
connector_gateway_health_port=9104
orchestration_service_grpc_port=9005
orchestration_service_health_port=9105
invoice_service_grpc_port=9006
invoice_service_health_port=9106
payment_link_service_grpc_port=9007
payment_link_service_health_port=9107
subscription_service_grpc_port=9008
subscription_service_health_port=9108
reconciliation_service_grpc_port=9009
reconciliation_service_health_port=9109
dispute_service_grpc_port=9010
dispute_service_health_port=9110
risk_service_grpc_port=9011
risk_service_health_port=9111
ai_assistant_service_grpc_port=9012
ai_assistant_service_health_port=9112
document_service_grpc_port=9013
document_service_health_port=9113
notification_service_grpc_port=9014
notification_service_health_port=9114
analytics_service_grpc_port=9015
analytics_service_health_port=9115
saga_coordinator_grpc_port=9016
saga_coordinator_health_port=9116
scheduler_grpc_port=9017
scheduler_health_port=9117
merchant_acquirer_link_service_grpc_port=9018
merchant_acquirer_link_service_health_port=9118
outbox_relay_grpc_port=9019
outbox_relay_health_port=9119
api_gateway_grpc_port=9020
api_gateway_health_port=9120
ai_gateway_grpc_port=9021
ai_gateway_health_port=9121
merchant_connector_onboarding_grpc_port=9022
merchant_connector_onboarding_health_port=9122

# ─── etcd (Service Discovery) ────────────────────────────────────────────────
ETCD_ENDPOINTS=http://localhost:2379

# ─── JWT / Auth (IAM Service) ───────────────────────────────────────────────
# Secret key for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# ─── SSRF Protection ─────────────────────────────────────────────────────────
# Set to 1 to allow HTTP URLs (for local development only; NEVER in production)
SSRF_ALLOW_HTTP=

# ─── OpenTelemetry / Tracing ─────────────────────────────────────────────────
# Uncomment to export traces to an OTLP-compatible collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=payment-orchestra

# ─── Prometheus Metrics ──────────────────────────────────────────────────────
# The metrics HTTP endpoint is served on the health port by default.
# No additional env vars needed if using the built-in `/metrics` endpoint.

# ─── MinIO (Document Service) ────────────────────────────────────────────────
# Optional — for document-service blob storage:
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=payment-orchestra-documents

# ─── General ─────────────────────────────────────────────────────────────────
# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# ---------------------------------------------------------------------------
# Developer Notes
# ---------------------------------------------------------------------------
# To generate a secure JWT secret:
#   openssl rand -hex 32
#
# To run integration tests that hit a real PostgreSQL database:
#   cargo test --features integration_test -- --test-threads=1
#   (Requires DATABASE_URL to point to a running PostgreSQL instance)
#
# To run the full stack locally:
#   docker compose up -d   # starts PostgreSQL, Redis, NATS, MinIO, etcd
#   cargo run -p {service-name}
